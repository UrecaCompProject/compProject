# .env.local로 복사해서 실제 값을 채워 넣으세요.
# .env.local은 Git에 커밋하지 마세요.
#
# 배포 환경 변수 안내
# - Vercel Dashboard > Environment Variables: VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY
# - Supabase Dashboard > Edge Functions > Secrets: OPENAI_API_KEY
#   (OPENAI_BASE_URL, OPENAI_MODEL은 기본값을 사용하려면 설정하지 않아도 됩니다)

# ───────────────────────────────────────────
# Supabase (프론트엔드 + Edge Function 통신용)
# ───────────────────────────────────────────
# Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# 로그인 세션 저장소 설정
# local: 브라우저 종료 후에도 localStorage에 유지 (기본)
# session: 같은 탭에서만 sessionStorage에 유지 (브라우저/탭 종료 시 삭제)
# false: persistSession 비활성화 (새로고침 시에도 로그아웃)
VITE_PERSIST_AUTH=local

# Supabase 관리용 Service Role Key (프론트엔드 절대 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ───────────────────────────────────────────
# OpenAI API 설정
# ───────────────────────────────────────────
# Edge Function가 OpenAI API를 호출할 때 사용합니다.
# Azure OpenAI 등 OpenAI 호환 엔드포인트를 사용하는 경우 OPENAI_BASE_URL도 함께 수정하세요.
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
