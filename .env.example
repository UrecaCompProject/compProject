# .env.local로 복사해서 실제 값을 채워 넣으세요.
# .env.local은 Git에 커밋하지 마세요.

# ───────────────────────────────────────────
# Supabase (프론트엔드 + Edge Function 통신용)
# ───────────────────────────────────────────
# 로컬 개발 시: http://localhost:54321
# 원격 프로덕션 시: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase 관리용 Service Role Key (프론트엔드 절대 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ───────────────────────────────────────────
# Ollama 로컬 LLM 설정
# ───────────────────────────────────────────
# Edge Function가 Ollama를 호출하는 주소.
# supabase functions serve를 사용하면 Edge Function이 호스트(localhost)에서 실행되므로
# http://localhost:11434를 그대로 사용할 수 있습니다.
# Cloudflare Tunnel 등을 쓰는 경우 OLLAMA_TUNNEL_URL에 외부 URL을 입력하세요.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TUNNEL_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M

# Cloudflare Tunnel 설정 (옵션)
# cloudflared tunnel --url http://localhost:11434
CLOUDFLARE_TUNNEL_URL=https://your-tunnel.trycloudflare.com


# ───────────────────────────────────────────
# 로컬 개발 시작 방법
# ───────────────────────────────────────────
# 1. 이 파일을 .env.local로 복사
# 2. npm install
# 3. npm run dev
#
# npm run dev는 아래 3개를 동시에 실행합니다:
# - vite (프론트엔드)
# - npx supabase functions serve (Edge Functions)
# - node scripts/dev-ollama.js (Ollama가 켜져 있지 않으면 자동 실행 시도)
