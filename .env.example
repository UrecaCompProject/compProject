# .env.local로 복사해서 실제 값을 채워 넣으세요.
# .env.local은 Git에 커밋하지 마세요.
#
# 배포 환경 변수 안내
# - Vercel Dashboard > Environment Variables: VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY
# - Supabase Dashboard > Edge Functions > Secrets: OPENAI_API_KEY
#   (OPENAI_BASE_URL, OPENAI_MODEL은 기본값을 사용하려면 설정하지 않아도 됩니다)

# ───────────────────────────────────────────
# Supabase (프론트엔드 + Edge Function 통신용)
# ───────────────────────────────────────────
# 로컬 개발 시: http://localhost:54321
# 원격 프로덕션 시: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase 관리용 Service Role Key (프론트엔드 절대 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ───────────────────────────────────────────
# OpenAI API 설정
# ───────────────────────────────────────────
# Edge Function가 OpenAI API를 호출할 때 사용합니다.
# Azure OpenAI 등 OpenAI 호환 엔드포인트를 사용하는 경우 OPENAI_BASE_URL도 함께 수정하세요.
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini


# ───────────────────────────────────────────
# 로컬 개발 시작 방법
# ───────────────────────────────────────────
# 1. 이 파일을 .env.local로 복사
# 2. npm install
# 3. npm run dev
#
# npm run dev는 아래 2개를 동시에 실행합니다:
# - vite (프론트엔드)
# - npx supabase functions serve (Edge Functions)
