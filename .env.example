# Supabase 클라우드 프로젝트 자격증명.
# 실제 값은 .env.local 에 입력하고 커밋하지 마세요.
# 키 발급 위치: Supabase Dashboard > Project Settings > API

# 프론트엔드 노출용 (RLS 적용 받음). NEXT_PUBLIC_ 접두어 필수.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...anon...

# 서버/스크립트 전용 (RLS 우회, 절대 브라우저 노출 금지).
# 백엔드 단독 개발자가 마이그레이션·관리 작업에만 사용.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...

# ───────────────────────────────────────────
# Ollama 로컬 LLM 설정
# ───────────────────────────────────────────
# 개발 환경: Ollama가 실행 중인 로컬 주소. 기본값 http://localhost:11434
# Supabase Edge Functions는 localhost에 직접 접근할 수 없으므로
# Cloudflare Tunnel 등으로 노출된 외부 URL을 OLLAMA_TUNNEL_URL에 입력합니다.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TUNNEL_URL=https://your-tunnel.trycloudflare.com
OLLAMA_MODEL=exaone3.5:2.4b

# ───────────────────────────────────────────
# Cloudflare Tunnel 설정
# ───────────────────────────────────────────
# 터널 실행 후 발급된 URL. Edge Functions에서 Ollama 호출 시 사용.
# cloudflared tunnel --url http://localhost:11434
CLOUDFLARE_TUNNEL_URL=https://your-tunnel.trycloudflare.com
